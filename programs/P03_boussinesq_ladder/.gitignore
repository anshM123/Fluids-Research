# large intermediate solver states (regenerable: bq_newton.py, bq_scan.py)
Y_*.npy
bq_P_*.npy
bq_X_*.npy
__pycache__/
Y2_*.npy
Y3_*.npy
Yr_*.npy
viz_profiles.png
# λ→1 limit-family solutions (regenerable in minutes: hl_limit.py, hl_limit_large.py; summary in hl_limit_table.txt)
hl_limit_Omf*.npz
# IPM continuation states (regenerable: ipm_solver.py, ipm_branch.py); rung states are kept as ipm_rung_*.npy
ipm_Y_*.npy
ipm_br_*.npy
# fine-grid limit-family check and the failed direct Kutta attempt (regenerable: HL_TAG=fine hl_limit_nk.py; hl_kutta.py)
hl_limit_fine_Omf*.npz
hl_limit_kutta.npz
# IPM states at the spectral-flow branch points (regenerable: ipm_state_at.py)
ipm_bp_lam*.npy
# deep-continuation states (regenerable: ipm_deep.py); the table ipm_deep_*.npy without _lam is kept
ipm_deep_*_lam*.npy
ipm_noise_*.npy
ipm_scan_*_z*.npy
ipm_nbcheck_*.npy
ipm_f1_start_*.npy
ipm_shift_*.npy
